generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model favorite_recipes {
  id_user      String   @db.Uuid
  id_recipe    Int
  favorited_at DateTime @default(now()) @db.Timestamptz(6)
  users        users    @relation(fields: [id_user], references: [id_user], onDelete: Cascade, onUpdate: NoAction)

  @@id([id_user, id_recipe])
  @@index([id_user], map: "idx_favorite_recipes_user")
}

model shopping_list {
  id_list             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_user             String                @db.Uuid
  title               String                @db.VarChar(100)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  users               users                 @relation(fields: [id_user], references: [id_user], onDelete: Cascade, onUpdate: NoAction)
  shopping_list_items shopping_list_items[]

  @@index([id_user], map: "idx_shopping_list_user")
}

model shopping_list_items {
  id_item          Int           @id @default(autoincrement())
  id_shopping_list String        @db.Uuid
  name             String        @db.VarChar(100)
  quantity         Decimal?      @db.Decimal
  unit             String?       @db.VarChar(100)
  bought           Boolean       @default(false)
  shopping_list    shopping_list @relation(fields: [id_shopping_list], references: [id_list], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id_shopping_list, name])
  @@index([id_shopping_list], map: "idx_shopping_list_items_list")
}

model users {
  id_user          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String             @unique @db.VarChar(100)
  senha            String             @db.VarChar(150)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  favorite_recipes favorite_recipes[]
  shopping_list    shopping_list[]
}

